{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "febriannugroho",
  "compatibility_date": "2026-11-20",
  // Static-only Worker: no script, Cloudflare serves the adapter-static output.
  "assets": {
    "directory": "./build",
    // /stack serves stack.html; unknown paths get build/404.html with a 404 status
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "febriannugroho.my.id", "custom_domain": true }],
  // Only the custom domain is public; no *.workers.dev copy of the site
  "workers_dev": false,
  "preview_urls": false
}
