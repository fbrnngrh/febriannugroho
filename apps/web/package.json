{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "fetch:github": "bun ../../scripts/fetch-github-contributions.ts",
    "build": "bun run fetch:github && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@selemondev/svgl-svelte": "^2.17.0",
    "lucide-svelte": "^1.0.1",
    "mdsvex": "^1.1.0"
  },
  "devDependencies": {
    "@febriannugroho/config": "workspace:*",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "catalog:",
    "vite": "^8.4.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
