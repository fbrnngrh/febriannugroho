{
  "context_servers": {
    "better-t-stack": {
      "source": "custom",
      "command": "bunx",
      "args": ["create-better-t-stack@latest", "mcp"],
      "env": {}
    },
    "context7": {
      "source": "custom",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    },
    "svelte": {
      "source": "custom",
      "type": "http",
      "url": "https://mcp.svelte.dev/mcp",
      "headers": {}
    }
  }
}
